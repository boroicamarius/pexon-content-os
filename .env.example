# =============================================================================
# PEXON — FOUR-FRAME CONTENT ENGINE
# =============================================================================
# Copy this file to .env. Every value below is a default and can be changed
# without touching code.
#
# ZERO-KEY BASELINE (Ollama + DuckDuckGo + CSV):
#   1. ollama pull llama3.1 nomic-embed-text
#   2. ollama serve
#   3. set the four LLM values and the embeddings values below
#   4. pexon doctor && pexon run --topic "Claude Anthropic Governance für deutsche Banken" --wait 0
#
# The default LLM_PROVIDER is openai-compatible, which is the wire protocol,
# not a vendor. OpenAI, Azure OpenAI, Ollama, vLLM, LiteLLM, OpenRouter,
# Together, Groq, DeepSeek, Mistral API, Fireworks, Anyscale and xAI all work
# through the same adapter.
# =============================================================================

# -- core ---------------------------------------------------------------------
APP_ENV=development
APP_NAME=pexon
LOG_LEVEL=INFO
LOG_FORMAT=json                    # json | text
TIMEZONE=Europe/Berlin
SITE_BASE_URL=https://pexon.example
RANDOM_SEED=42

# -- paths (relative to the project root) ------------------------------------
DB_PATH=db/pexon.db
SCHEMA_PATH=db/schema.sql
ANALYTICS_CSV=data/analytics.csv
LEADS_CSV=data/leads.csv
KEYWORD_CSV=data/keyword_demand.csv
CONTENT_DIR=content/posts
PENDING_DIR=content/pending
SITEMAP_PATH=content/sitemap.xml
ROBOTS_PATH=content/robots.txt
CACHE_DIR=.cache

# -- generator LLM ------------------------------------------------------------
# Zero-key local default:
LLM_PROVIDER=openai-compatible     # openai-compatible | anthropic | gemini
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=not-needed
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
LLM_JSON_RETRIES=1

# Bank-style example (no code change):
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-sonnet-4-5
# LLM_API_KEY=sk-ant-...

# -- judge LLM: independent role, same two adapters --------------------------
# Leave empty to reuse the generator (a warning event is recorded).
# To use a deliberately different family:
# JUDGE_LLM_PROVIDER=anthropic
# JUDGE_LLM_BASE_URL=https://api.anthropic.com
# JUDGE_LLM_MODEL=claude-sonnet-4-5
# JUDGE_LLM_API_KEY=sk-ant-...
JUDGE_LLM_PROVIDER=
JUDGE_LLM_BASE_URL=
JUDGE_LLM_MODEL=
JUDGE_LLM_API_KEY=
JUDGE_LLM_TEMPERATURE=0.0
JUDGE_LLM_MAX_TOKENS=1400

# -- search: DuckDuckGo is keyless -------------------------------------------
SEARCH_PROVIDER=duckduckgo         # duckduckgo | tavily | brave | serpapi
SEARCH_FALLBACK_CHAIN=duckduckgo   # comma-separated, e.g. tavily,brave,duckduckgo
SEARCH_RESULTS_PER_QUERY=8
SEARCH_TIMEOUT_SECONDS=30
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=
DEEP_RESEARCH_USER_AGENT=Mozilla/5.0 (compatible; PexonResearch/0.1)

# -- fetch / extraction -------------------------------------------------------
FETCH_PROVIDER=trafilatura         # trafilatura | httpx | playwright
FETCH_TIMEOUT_SECONDS=30
FETCH_MAX_CHARS=18000
FETCH_MIN_CHARS=300
FETCH_TOP_N=8
FETCH_WORKERS=6
FETCH_USER_AGENT=Mozilla/5.0 (compatible; PexonResearch/0.1)
PLAYWRIGHT_HEADLESS=true

# -- embeddings ---------------------------------------------------------------
EMBEDDINGS_PROVIDER=openai-compatible   # openai-compatible | local
EMBEDDINGS_BASE_URL=http://localhost:11434/v1
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_API_KEY=not-needed
EMBEDDINGS_TIMEOUT_SECONDS=60
EMBEDDINGS_LOCAL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_LOCAL_DIM=512

# -- analytics ----------------------------------------------------------------
ANALYTICS_PROVIDER=csv             # csv | gsc | plausible | matomo
ANALYTICS_WINDOW_DAYS=28

# Google Search Console (OAuth refresh token or service account).
GSC_SITE_URL=
GSC_ACCESS_TOKEN=
GSC_REFRESH_TOKEN=
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_SERVICE_ACCOUNT_JSON=

# Plausible: visitors map to clicks, pageviews map to impressions.
PLAUSIBLE_BASE_URL=https://plausible.io
PLAUSIBLE_SITE_ID=
PLAUSIBLE_API_KEY=

# Matomo: visits map to clicks, hits map to impressions.
MATOMO_BASE_URL=
MATOMO_SITE_ID=
MATOMO_TOKEN=

# -- CRM / business attribution ----------------------------------------------
CRM_PROVIDER=csv                   # csv | hubspot
CRM_TIMEOUT_SECONDS=30
HUBSPOT_API_KEY=
HUBSPOT_ARTICLE_PROPERTY=pexon_article_id
HUBSPOT_PIPELINE_PROPERTY=pexon_pipeline_value
HUBSPOT_WON_PROPERTY=pexon_won_value

# -- GEO visibility: real answer engines, not simulations --------------------
GEO_PROVIDER=none                  # none | perplexity | openai | gemini
GEO_BRAND_NAME=Pexon
GEO_DOMAIN=
GEO_QUERY_COUNT=3
GEO_TIMEOUT_SECONDS=60
GEO_PERPLEXITY_MODEL=sonar
GEO_OPENAI_MODEL=gpt-4.1-mini
GEO_GEMINI_MODEL=gemini-2.5-flash
PERPLEXITY_API_KEY=
GEO_OPENAI_API_KEY=
GEO_GEMINI_API_KEY=

# -- keyword demand / portfolio planning --------------------------------------
KEYWORD_PROVIDER=csv               # csv | dataforseo
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
KEYWORD_LOCATION_CODE=276
KEYWORD_LANGUAGE_CODE=de
KEYWORD_TIMEOUT_SECONDS=30
PLAN_TOP_N=10
PLAN_MIN_VOLUME=0
PLAN_CTR=0.03
PLAN_INTENT_WEIGHTS=informational=0.4,commercial=0.8,transactional=1.0,navigational=0.2
PLAN_FUNNEL_WEIGHTS=top=0.5,middle=0.8,bottom=1.0
PLAN_DIFFICULTY_SCALE=100
PLAN_COVERAGE_PENALTY=0.50
PLAN_VOLUME_CEILING=10000
PLAN_CANDIDATE_POOL=50

# -- publishing / technical SEO -----------------------------------------------
PUBLISHING_PROVIDER=markdown       # markdown | wordpress | webhook
PUBLISHING_TIMEOUT_SECONDS=30
WORDPRESS_BASE_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
WORDPRESS_STATUS=publish
WEBHOOK_URL=
WEBHOOK_TOKEN=
INTERNAL_LINK_COUNT=2
INTERNAL_LINK_LOOKBACK=25
META_DESCRIPTION_CHARS=155
SITEMAP_ENABLED=true

# -- human review -------------------------------------------------------------
REQUIRE_HUMAN_REVIEW=false

# -- unit economics -----------------------------------------------------------
# Set these to the rates in your provider contracts; zero is correct for local Ollama.
LLM_INPUT_COST_PER_1K=0.0
LLM_OUTPUT_COST_PER_1K=0.0
SEARCH_COST_PER_CALL=0.0
FETCH_COST_PER_CALL=0.0
ARTICLE_FIXED_COST=0.0
COST_CURRENCY=USD

# -- business funnel ----------------------------------------------------------
FUNNEL_WINDOW_DAYS=90

# -- storage / cache / tracing ------------------------------------------------
STORAGE_PROVIDER=sqlite            # sqlite | postgres
DATABASE_URL=                      # postgresql://user:pass@host/db
CACHE_PROVIDER=json                # json | redis
CACHE_TTL_SECONDS=86400
REDIS_URL=
TRACING_PROVIDER=none              # none | langsmith
LANGCHAIN_TRACING_V2=false         # true auto-selects langsmith when provider is none
LANGSMITH_PROJECT=pexon
# LangSmith also reads LANGCHAIN_API_KEY / LANGCHAIN_TRACING_V2 from the env.

# -- research thresholds ------------------------------------------------------
RESEARCH_QUERY_COUNT=4
RESEARCH_WORKERS=4
RESEARCH_PROMPT_MAX_CHARS=30000
RESEARCH_MAX_FACTS=20
FACT_CONFIDENCE_MIN=0.55
FACT_VERIFICATION_MAX_CHARS=7000
CITATION_VERIFY_THRESHOLD=0.58

# -- generation thresholds ----------------------------------------------------
GEN_SAMPLE_COUNT=3
GEN_REFINE_TOP_K=1
GEN_ANGLES=direkt,deep,compliance,management,praxis
DIRECTION_KEY_POINTS=5
MAX_RETRIES=2
DRAFT_TARGET_WORDS=900
DRAFT_MAX_WORDS=1600
DRAFT_MAX_TOKENS=4200
BASELINE_CLICKS=40
BASELINE_IMPRESSIONS=1200
DUP_SIM_THRESHOLD=0.92
SEMANTIC_DEDUPE_THRESHOLD=0.88
JUDGE_FACTUALITY_MIN=0.75
JUDGE_COMPLIANCE_MIN=0.80
JUDGE_FLUENCY_MIN=0.80
JUDGE_BODY_MAX_CHARS=16000
COMPLIANCE_KEYWORDS=DSGVO,DORA,MaRisk,AI Act
COMPLIANCE_MIN_MATCHES=2
MIN_CITATIONS=2
CITATION_TARGET_COUNT=6
CITATION_COVERAGE_MIN=0.50
MIN_ARTICLE_WORDS=350
ANSWER_FIRST_MAX_WORDS=70
ENTITY_TARGET_COUNT=8
HEADING_TARGET_COUNT=6
FRESHNESS_REFERENCE_DAYS=365
FEATURE_FRESHNESS_MISSING=0.50
SLUG_MAX_LENGTH=90
EXPECTED_DEFAULT_POSITION=10
DUPLICATE_CORPUS_LIMIT=50
FEATURE_ANSWER_FIRST_FALLBACK=0.30
FEATURE_SEO_KEYWORD_WEIGHT=0.50
FEATURE_SEO_STRUCTURE_WEIGHT=0.50
FEATURE_GEO_ENTITY_WEIGHT=0.45
FEATURE_GEO_STRUCTURE_WEIGHT=0.35
FEATURE_GEO_HEADING_WEIGHT=0.20
FEATURE_AEO_ANSWER_WEIGHT=0.60
FEATURE_AEO_ENTITY_WEIGHT=0.25
FEATURE_AEO_FAQ_BONUS=0.15
GERMAN_MIN_SCORE=0.42
GERMAN_STOPWORD_MULTIPLIER=2.2
GERMAN_UMLAUT_BONUS_CAP=0.15
GERMAN_SAMPLE_CHARS=6000

# -- intelligence thresholds --------------------------------------------------
COMPETITOR_TOP_N=6
COMPETITOR_SEARCH_QUERIES=2
INTELLIGENCE_ENGINES=chatgpt,perplexity,gemini,claude
INTELLIGENCE_WORKERS=4
ENGINE_ANSWER_MAX_TOKENS=900
ENGINE_ANSWER_EXCERPT_CHARS=3500
PAGE_RANK_MAX_TOKENS=1200
INSIGHT_MAX_TOKENS=1200

# -- learner: champion-challenger ---------------------------------------------
MIN_TRAINING_ROWS=12
TRAIN_TEST_SPLIT=0.25
CHAMPION_MIN_DELTA=0
BOOTSTRAP_ITERATIONS=400
CI_LOWER_PERCENTILE=0.10
CI_UPPER_PERCENTILE=0.90
GB_N_ESTIMATORS=120
GB_LEARNING_RATE=0.05
GB_MAX_DEPTH=3
GB_MIN_SAMPLES_LEAF=5
GB_SUBSAMPLE=0.9
COLD_START_CLICK_MULTIPLIER=1.35
COLD_START_IMPRESSION_MULTIPLIER=1.35
COLD_START_CI_SPREAD=0.28

# -- drift --------------------------------------------------------------------
DRIFT_PSI_THRESHOLD=0.20
DRIFT_KS_THRESHOLD=0.20
DRIFT_WINDOW_DAYS=28
DRIFT_MIN_ROWS=8
DRIFT_BINS=10
DRIFT_EPSILON=0.000001

# -- reflection ---------------------------------------------------------------
MAX_ITERATIONS=2
PROPOSE_ERROR_THRESHOLD=0.35
REFLECTION_PROMPT_MAX_TOKENS=1400

# -- guards -------------------------------------------------------------------
# Comma-separated regex corpus; commas inside regexes are not supported.
INJECTION_PATTERNS=ignore (all |any )?(previous|prior) instructions,disregard (all |any )?(previous|prior) instructions,system prompt,you are now,reveal (your|the) (system )?prompt,developer mode,jailbreak
PII_PUBLIC_FIGURES=
PII_REDACTION_TOKEN=[REDACTED]

# -- runtime ------------------------------------------------------------------
DRILL_FETCH_URL=https://example.com
RECURSION_LIMIT=120
STREAM_MODE=updates
